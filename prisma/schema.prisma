generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  createdAt   DateTime         @default(now()) @map("created_at")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  key       String           @unique
  createdAt DateTime         @default(now()) @map("created_at")
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id") @db.Uuid
  role         Role      @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  employee     Employee?
  sessions     Session[]
  appraisalsGiven EmployeeAppraisal[]
  leaveRequestsCreated LeaveRequest[]
  createdProjects Project[]
  createdTasks Task[]
  taskComments TaskComment[]
  notifications Notification[]
  taskActivities TaskActivity[]
  taskAttachments TaskAttachment[]

  @@index([roleId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

enum EmployeeStatus {
  ACTIVE
  ARCHIVED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  fullName     String         @map("full_name")
  jobTitle     String         @map("job_title")
  email        String         @unique
  hireDate     DateTime       @map("hire_date")
  dateOfBirth  DateTime?      @map("date_of_birth")
  salary       Decimal?       @db.Decimal(12, 2)
  startingSalary Decimal?     @map("starting_salary") @db.Decimal(12, 2)
  status       EmployeeStatus @default(ACTIVE)
  userId       String?        @unique @map("user_id") @db.Uuid
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId String?        @map("department_id") @db.Uuid
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId       String?        @map("team_id") @db.Uuid
  team         Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scheduleId   String?        @map("schedule_id") @db.Uuid
  schedule     WorkSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  photoStorageKey String?     @map("photo_storage_key")
  photoMimeType   String?     @map("photo_mime_type")
  /// Annual allowance in days, admin-set. leavesTaken is derived from
  /// LeaveRequest.days and recomputed on every create/delete — never
  /// written to directly, same pattern as Employee.salary.
  leavesAvailable Int         @default(0) @map("leaves_available")
  leavesTaken     Int         @default(0) @map("leaves_taken")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  ledTeams     Team[]         @relation("TeamLead")
  appraisals   EmployeeAppraisal[]
  leaveRequests LeaveRequest[]
  ledProjects  Project[]      @relation("ProjectLead")
  assignedTasks Task[]        @relation("TaskAssignee")
  timeEntries  TimeEntry[]

  @@index([status])
  @@index([departmentId])
  @@index([teamId])
  @@index([scheduleId])
  @@map("employees")
}

model EmployeeAppraisal {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  appraisalDate  DateTime @map("appraisal_date")
  percentageHike Decimal  @map("percentage_hike") @db.Decimal(5, 2)
  notes          String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_appraisals")
}

enum LeaveType {
  SICK
  CASUAL
  VACATION
  UNPAID
  OTHER
}

model LeaveRequest {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  days        Int
  type        LeaveType @default(VACATION)
  notes       String?
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("leave_requests")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  employees   Employee[]
  teams       Team[]
  projects    Project[]
  tasks       Task[]

  @@map("departments")
}

model Team {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  departmentId String       @map("department_id") @db.Uuid
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teamLeadId   String?      @map("team_lead_id") @db.Uuid
  teamLead     Employee?    @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  description  String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  employees    Employee[]
  projects     Project[]
  tasks        Task[]

  @@index([departmentId])
  @@map("teams")
}

model WorkSchedule {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  status    RecordStatus      @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  days      WorkScheduleDay[]
  employees Employee[]

  @@map("work_schedules")
}

enum ProjectStatus {
  PLANNING
  NOT_STARTED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  client          String?
  description     String?
  departmentId    String?       @map("department_id") @db.Uuid
  department      Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId          String?       @map("team_id") @db.Uuid
  team            Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  projectLeadId   String?       @map("project_lead_id") @db.Uuid
  projectLead     Employee?     @relation("ProjectLead", fields: [projectLeadId], references: [id], onDelete: SetNull)
  startDate       DateTime?     @map("start_date")
  endDate         DateTime?     @map("end_date")
  budget          Decimal?      @db.Decimal(12, 2)
  estimatedHours  Decimal?      @map("estimated_hours") @db.Decimal(8, 2)
  status          ProjectStatus @default(PLANNING)
  priority        Priority      @default(MEDIUM)
  tags            String[]      @default([])
  createdById     String?       @map("created_by_id") @db.Uuid
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  tasks           Task[]
  notifications   Notification[]

  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model Task {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  projectId       String?       @map("project_id") @db.Uuid
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId    String?       @map("department_id") @db.Uuid
  department      Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId          String?       @map("team_id") @db.Uuid
  team            Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdById     String?       @map("created_by_id") @db.Uuid
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId      String?       @map("assignee_id") @db.Uuid
  assignee        Employee?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority        Priority      @default(MEDIUM)
  status          TaskStatus    @default(NOT_STARTED)
  startDate       DateTime?     @map("start_date")
  dueDate         DateTime?     @map("due_date")
  estimatedHours  Decimal?      @map("estimated_hours") @db.Decimal(8, 2)
  completionDate  DateTime?     @map("completion_date")
  tags            String[]      @default([])
  links           String[]      @default([])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  checklistItems  TaskChecklistItem[]
  timeEntries     TimeEntry[]
  comments        TaskComment[]
  activities      TaskActivity[]
  attachments     TaskAttachment[]
  notifications   Notification[]

  @@index([projectId])
  @@index([departmentId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
  @@map("tasks")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_COMPLETED
  COMMENT_ADDED
  TASK_DUE_SOON
  TASK_OVERDUE
  PROJECT_DEADLINE
}

model Notification {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  body             String?
  isRead           Boolean           @default(false) @map("is_read")
  relatedTaskId    String?           @map("related_task_id") @db.Uuid
  relatedTask      Task?             @relation(fields: [relatedTaskId], references: [id], onDelete: Cascade)
  relatedProjectId String?           @map("related_project_id") @db.Uuid
  relatedProject   Project?          @relation(fields: [relatedProjectId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_activities")
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  storageKey   String   @map("storage_key")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_attachments")
}

model TaskChecklistItem {
  id      String  @id @default(uuid()) @db.Uuid
  taskId  String  @map("task_id") @db.Uuid
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   String
  isDone  Boolean @default(false) @map("is_done")
  order   Int     @default(0)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TimeEntry {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  hours       Decimal  @db.Decimal(6, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([employeeId])
  @@index([date])
  @@map("time_entries")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_comments")
}

model WorkScheduleDay {
  id            String       @id @default(uuid()) @db.Uuid
  scheduleId    String       @map("schedule_id") @db.Uuid
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek     Int          @map("day_of_week")
  isWorkingDay  Boolean      @default(true) @map("is_working_day")
  startTime     String?      @map("start_time")
  endTime       String?      @map("end_time")
  breakMinutes  Int          @default(0) @map("break_minutes")

  @@unique([scheduleId, dayOfWeek])
  @@map("work_schedule_days")
}
