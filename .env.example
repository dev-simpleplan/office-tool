# Postgres connection string used by Prisma and the API
DATABASE_URL="postgresql://officeadmin:officepassword@127.0.0.1:5432/office_platform?schema=public"

# Secret used to sign session cookies. Generate a long random value in real environments.
SESSION_SECRET="change-me-to-a-long-random-string"

# Base URL of the API, used by the API itself for cookie/cors config
API_URL="http://localhost:4000"

# Base URL of the web app, used by the API for CORS allow-list
WEB_URL="http://localhost:5173"

# Where the API stores local files (reserved for a later phase)
STORAGE_PATH="./storage"

# Base URL the web/desktop apps use to reach the API (must be prefixed VITE_ to be exposed to Vite)
VITE_API_URL="http://localhost:4000"

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=officeadmin
POSTGRES_PASSWORD=officepassword
POSTGRES_DB=office_platform
